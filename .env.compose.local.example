# Docker Compose 本機 User OAuth UAT 最小設定。
# 複製為 .env.compose.local 後，只填以下四個必要值。
# 啟動命令：COMPOSE_MCP_ENV_FILE=.env.compose.local docker compose up --build

# 每位 IDE 使用者登入 PingCode；Compose 會自動啟動 Redis 保存加密 Session。
PINGCODE_AUTH_MODE=user_oauth

# PingCode 後台建立的 User OAuth 應用憑據，不是 enterprise Client Credentials。
PINGCODE_CLIENT_ID=replace-with-user-oauth-client-id
PINGCODE_CLIENT_SECRET=replace-with-user-oauth-client-secret

# 使用 openssl rand -base64 32 生成；更換此值會令既有 Redis OAuth Session 失效。
MCP_OAUTH_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-base64-32

# 以下為選填。本機公有雲、30 分鐘 Access Token、30 天 Refresh Token 及預設 retry 均不需配置。
LOG_LEVEL=info
MCP_METRICS_ENABLED=false
# MCP_METRICS_BEARER_TOKEN=replace-with-at-least-32-character-random-token
