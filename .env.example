# 完整設定參考。Docker Compose 本機 User OAuth 請優先複製 .env.compose.local.example，
# 不需要在此填滿所有選項。

# PingCode API 基礎地址。
# 公有雲保持預設值；私有部署或企業閘道請改成客戶提供的地址。
PINGCODE_API_BASE_URL=https://open.pingcode.com

# PingCode OAuth 瀏覽器授權頁根地址，不是 REST API 根地址。
# 公有雲固定包含 /oauth2；私有部署通常為 https://自訂域名/oauth2。
PINGCODE_OAUTH_BASE_URL=https://open.pingcode.com/oauth2

# 認證模式：
# - enterprise：使用企業 Client Credentials，可搭配 stdio 或 HTTP。
# - user_oauth：每位使用者登入 PingCode，只支援 Streamable HTTP。
PINGCODE_AUTH_MODE=enterprise

# PingCode 應用的 Client ID；請由 Secret Manager 或本機 .env 提供實際值。
PINGCODE_CLIENT_ID=replace-with-client-id

# PingCode 應用的 Client Secret；不得提交實際值到 Git。
PINGCODE_CLIENT_SECRET=replace-with-client-secret

# 單次 PingCode API／OAuth 請求逾時，單位毫秒；允許範圍 1000～120000。
PINGCODE_REQUEST_TIMEOUT_MS=10000

# 單次 PingCode API 響應大小上限，單位 bytes；預設 1 MiB。
PINGCODE_MAX_RESPONSE_BYTES=1048576

# 唯讀 API 的最大重試次數；只重試網路錯誤、逾時、429、5xx 及一次 401 Token 刷新。
PINGCODE_MAX_RETRIES=2

# 指數退避的基礎與最大等待時間，單位毫秒；429 會優先遵守 Retry-After，但仍受最大值限制。
PINGCODE_RETRY_BASE_DELAY_MS=250
PINGCODE_RETRY_MAX_DELAY_MS=2000

# MCP HTTP Server 綁定地址。
# 本機可用 localhost／127.0.0.1；遠端部署通常使用 0.0.0.0。
MCP_HOST=127.0.0.1

# MCP HTTP Server 監聽埠。
MCP_PORT=3000

# 是否允許綁定非本機地址。
# 只有 MCP_HOST 使用非本機地址時才設為 true。
MCP_ALLOW_REMOTE=false

# 允許的 HTTP Host，逗號分隔。
# 本機可留空；遠端應填公開域名，例如 mcp.example.com。
MCP_ALLOWED_HOSTS=

# user_oauth 必填：MCP 對 Client 公開的 origin，不包含 /mcp。
# 本機範例與 PingCode callback：
# MCP_PUBLIC_BASE_URL=http://localhost:3000
# callback=http://localhost:3000/auth/pingcode/callback
MCP_PUBLIC_BASE_URL=

# OAuth 狀態儲存方式：
# - memory：只供本機 UAT。
# - redis：正式／多 instance 部署必須使用。
MCP_OAUTH_STORE=memory

# 使用 redis Store 時必填；應由 Secret Manager 注入，不要提交真實密碼。
MCP_OAUTH_REDIS_URL=

# 是否優先支援 OAuth Client ID Metadata Documents；不支援 CIMD 的 Client 仍回退 DCR。
MCP_OAUTH_CIMD_ENABLED=true

# 選填：允許取得 CIMD metadata 的 HTTPS host，逗號分隔；留空表示允許所有公網 host。
# 企業部署可依 UAT 結果限制，例如：client.example.com,another-client.example.com
MCP_OAUTH_CIMD_ALLOWED_HOSTS=

# DCR fallback Client 註冊有效期，單位秒；預設 365 天，允許範圍 1 天至 2 年。
MCP_OAUTH_DCR_CLIENT_TTL_SECONDS=31536000

# user_oauth 必填：Base64 編碼的 32-byte AES 加密金鑰。
# 本機可執行：openssl rand -base64 32
MCP_OAUTH_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-base64-32

# MCP Access Token 有效期，單位秒；允許範圍 300～86400。
MCP_OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600

# MCP Refresh Token／OAuth Session 有效期，單位秒；預設 30 天。
MCP_OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# 是否啟用本機程序級 JSON Metrics endpoint：GET /metrics。
# 預設關閉；正式環境只應供監控系統經內網或 Gateway 存取。
MCP_METRICS_ENABLED=false

# Metrics 專用 Bearer Token；啟用時至少 32 字元，必須由 Secret Manager 注入。
# 不得重用 PingCode Token、MCP OAuth Token 或 Client Secret。
MCP_METRICS_BEARER_TOKEN=

# 日誌級別，可選 debug、info、warn、error。
LOG_LEVEL=info

# 選填：從另一個絕對路徑載入環境檔。
# 此變數應由啟動程序或 MCP Client 設定，不要寫在它指向的環境檔內。
# PINGCODE_ENV_FILE=/absolute/path/to/pingcode-mcp.env
